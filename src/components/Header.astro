<header class="site-header" aria-label="Hoofdnavigatie">
  <a class="brand" href="#top" aria-label="Thomas Montage & Klussen, startpagina"><img src="/assets/logo.svg" width="190" height="55" alt="Thomas Montage & Klussen" /></a>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="navigation" aria-label="Menu openen"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span><span class="menu-label">Menu</span></button>
  <nav id="navigation" class="main-nav" aria-label="Primaire navigatie">
    <a href="#diensten"><span>Diensten</span></a><a href="#over-thomas"><span>Over Thomas</span></a><a href="#contact"><span>Contact</span></a><a class="button button--small" href="#contact"><span>Bespreek je klus</span></a>
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header-wrap');
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const menuLabel = menuButton?.querySelector<HTMLElement>('.menu-label');
  const nav = document.querySelector<HTMLElement>('.main-nav');

  const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  const setMenu = (open: boolean) => {
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    if (menuLabel) menuLabel.textContent = open ? 'Sluiten' : 'Menu';
    nav?.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('menu-open', open);
  };

  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });
  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
